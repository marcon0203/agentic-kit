{
  "descriptor_version": 1,
  "id": "volcengine",
  "label": "火山引擎方舟（Ark）",
  "wire": "openai.chat.v1",
  "description": "火山方舟 v3 接口，线协议与 OpenAI Chat Completions 兼容。model 填推理接入点 ID（ep-xxxxxxxx）或方舟支持的模型名。价格表刻意留空：方舟按人民币计价且随接入点档位变化，硬编一个折算汇率进来会让成本统计看着像真的、其实是错的——EstimateCost 对没有价格的模型按 0 处理，token 数照常记录。",
  "capabilities": [
    "text",
    "tools",
    "stream",
    "embed"
  ],
  "base_url": "https://ark.cn-beijing.volces.com/api/v3",
  "credentials": [
    {
      "name": "api_key",
      "type": "secret",
      "label": "API Key",
      "required": true
    },
    {
      "name": "base_url",
      "type": "url",
      "label": "接口地址（留空用官方默认）",
      "required": false
    }
  ],
  "auth": {
    "driver": "bearer",
    "credential": "api_key"
  },
  "messages": {
    "system": "inline",
    "content": "string",
    "tool_calls": "sibling_field",
    "tool_calls_field": "tool_calls",
    "tool_call_part": {
      "id": "$.id",
      "type": "function",
      "function": {
        "name": "$.name",
        "arguments": {
          "$json": "$.arguments"
        }
      }
    }
  },
  "complete": {
    "method": "POST",
    "path": "/chat/completions",
    "body": {
      "model": "$.model",
      "messages": "$.messages",
      "tools": "$.tools",
      "max_tokens": "$.max_tokens",
      "temperature": "$.temperature"
    },
    "response": {
      "text": [
        "choices.0.message.content"
      ],
      "reasoning": [
        "choices.0.message.reasoning_content"
      ],
      "tool_calls": {
        "each": "choices.0.message.tool_calls",
        "id": "id",
        "name": "function.name",
        "arguments_json": "function.arguments"
      },
      "usage": {
        "input": "usage.prompt_tokens",
        "output": "usage.completion_tokens"
      },
      "error": {
        "when": "error",
        "code": "error.code",
        "message": "error.message"
      }
    }
  },
  "stream": {
    "request": {
      "patch": {
        "stream": true,
        "stream_options": {
          "include_usage": true
        }
      }
    },
    "transport": "sse",
    "done": [
      "[DONE]"
    ],
    "on": [
      {
        "emit_text": "$.choices.0.delta.content"
      },
      {
        "emit_reasoning": "$.choices.0.delta.reasoning_content"
      },
      {
        "each": "$.choices.0.delta.tool_calls",
        "index": "$.index",
        "set_id": "$.id",
        "set_name": "$.function.name",
        "append_args": "$.function.arguments"
      },
      {
        "usage_in": "$.usage.prompt_tokens",
        "usage_out": "$.usage.completion_tokens"
      },
      {
        "fail": "$.error.message"
      }
    ]
  },
  "probe": {
    "method": "GET",
    "path": "/models"
  },
  "embed": {
    "method": "POST",
    "path": "/embeddings",
    "body": {
      "model": "$.model",
      "input": "$.texts"
    },
    "response": {
      "each": "data",
      "vector": "embedding"
    }
  }
}
