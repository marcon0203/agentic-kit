[
  {
    "name": "基础文本 + usage（system 走 instructions，消息走 input）",
    "request": {
      "model": "gpt-5",
      "messages": [
        {
          "role": "system",
          "content": "你是一个助手"
        },
        {
          "role": "user",
          "content": "你好"
        }
      ],
      "max_tokens": 100,
      "temperature": 0.7
    },
    "expect_http": {
      "method": "POST",
      "path": "/responses",
      "body": {
        "model": "gpt-5",
        "instructions": "你是一个助手",
        "input": [
          {
            "role": "user",
            "content": "你好"
          }
        ],
        "max_output_tokens": 100,
        "temperature": 0.7
      }
    },
    "complete_response": {
      "id": "resp_1",
      "object": "response",
      "status": "completed",
      "output": [
        {
          "type": "message",
          "role": "assistant",
          "content": [
            {
              "type": "output_text",
              "text": "你好，有什么可以帮你？"
            }
          ]
        }
      ],
      "usage": {
        "input_tokens": 12,
        "output_tokens": 8
      }
    },
    "stream_response": "event: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"你好\"}\n\nevent: response.output_text.delta\ndata: {\"type\":\"response.output_text.delta\",\"delta\":\"，有什么可以帮你？\"}\n\nevent: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"usage\":{\"input_tokens\":12,\"output_tokens\":8}}}\n\n",
    "expect_result": {
      "content": "你好，有什么可以帮你？",
      "input_tokens": 12,
      "output_tokens": 8
    }
  },
  {
    "name": "工具调用（定义摊平但带 type，参数是 JSON 字符串）",
    "request": {
      "model": "gpt-5",
      "messages": [
        {
          "role": "user",
          "content": "北京天气"
        }
      ],
      "tools": [
        {
          "name": "get_weather",
          "description": "查询天气",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      ]
    },
    "expect_http": {
      "method": "POST",
      "path": "/responses",
      "body": {
        "tools": [
          {
            "type": "function",
            "name": "get_weather",
            "description": "查询天气",
            "parameters": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        ]
      }
    },
    "complete_response": {
      "id": "resp_2",
      "object": "response",
      "output": [
        {
          "type": "function_call",
          "call_id": "call_1",
          "name": "get_weather",
          "arguments": "{\"city\": \"北京\"}"
        }
      ],
      "usage": {
        "input_tokens": 20,
        "output_tokens": 15
      }
    },
    "stream_response": "event: response.output_item.added\ndata: {\"type\":\"response.output_item.added\",\"output_index\":0,\"item\":{\"type\":\"function_call\",\"call_id\":\"call_1\",\"name\":\"get_weather\"}}\n\nevent: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\"output_index\":0,\"delta\":\"{\\\"ci\"}\n\nevent: response.function_call_arguments.delta\ndata: {\"type\":\"response.function_call_arguments.delta\",\"output_index\":0,\"delta\":\"ty\\\": \\\"北京\\\"}\"}\n\nevent: response.completed\ndata: {\"type\":\"response.completed\",\"response\":{\"usage\":{\"input_tokens\":20,\"output_tokens\":15}}}\n\n",
    "expect_result": {
      "input_tokens": 20,
      "output_tokens": 15,
      "tool_calls": [
        {
          "id": "call_1",
          "name": "get_weather",
          "arguments": {
            "city": "北京"
          }
        }
      ]
    }
  }
]
