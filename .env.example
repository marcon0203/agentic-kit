# Copy to .env and fill in real values for local development.
# See internal/config/config.go for the authoritative list of required vars.

# development | staging | production
APP_ENV=development

# Port the API server listens on.
HTTP_PORT=8080

# PostgreSQL 16 connection string.
DATABASE_URL=postgres://agentic_kit:agentic_kit@localhost:5432/agentic_kit?sslmode=disable

# HMAC secret used to sign JWTs (access + refresh tokens). Generate with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-32-byte-secret

# AES-256 key (32 raw bytes, base64-encoded) used to encrypt stored
# credentials (model provider keys, MCP server secrets). Generate with:
#   openssl rand -base64 32
CREDENTIAL_AES_KEY=change-me-to-a-random-32-byte-key

# 知识库 feature switch. Off by default — a fresh install with neither
# Milvus nor Elasticsearch deployed still boots cleanly. When true,
# MILVUS_ADDR and ELASTICSEARCH_ADDR below become required.
KB_ENABLED=false

# Milvus (vector search) connection. MILVUS_USERNAME/PASSWORD are optional —
# leave blank for a Milvus instance with auth disabled (e.g. local dev).
MILVUS_ADDR=localhost:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

# Elasticsearch (keyword/BM25 search, the second leg of 多路召回) connection.
# Use either USERNAME/PASSWORD (Basic auth) or API_KEY, not both; leave all
# three blank for an Elasticsearch instance with security disabled.
ELASTICSEARCH_ADDR=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=
